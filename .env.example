# ShopWave local Docker configuration
# Copy this file to .env. Values here are development-only.

# Published host ports
FRONTEND_PORT=3000
BACKEND_PORT=8090
POSTGRES_PORT=5433
REDIS_PORT=6379
ES_PORT=9200
KAFKA_PORT=9093

# Core runtime
SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=shopwave
POSTGRES_USER=shopwave
POSTGRES_PASSWORD=password123
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
OAUTH_VALIDATE_CONFIG_AT_STARTUP=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3090
EMAIL_VERIFICATION_BASE_URL=http://localhost:3000
BCRYPT_STRENGTH=10
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Authentication
# This placeholder is intentionally insecure. Replace it outside local development.
JWT_SECRET=VGhpcy1pcy1hLWRldmVsb3BtZW50LW9ubHktU2hvcFdhdmUtSFM1MTItc2VjcmV0LXJlcGxhY2UtaXQtaW4tcHJvZHVjdGlvbi1ub3ch
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=shopwave-api
# Local HTTP requires a non-secure cookie. Use true whenever the app is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Frontend build-time values (VITE_* values are public in the browser bundle)
VITE_BACKEND_URL=/api
VITE_FRONTEND_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=
VITE_MSAL_CLIENT_ID=
VITE_MSAL_AUTHORITY=
VITE_RECAPTCHA_SITE_KEY=

# OAuth and captcha
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
APPLE_CLIENT_ID=
RECAPTCHA_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_WEBHOOK_SECRET=
STRIPE_PREMIUM_SUCCESS_URL=http://localhost:3000/account?upgrade=success
STRIPE_PREMIUM_CANCEL_URL=http://localhost:3000/account
STRIPE_PREMIUM_PORTAL_RETURN_URL=http://localhost:3000/account

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@shopwave.com
SUPPORT_TEAM_EMAIL=support@shopwave.com

# S3-compatible file storage
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_URL_BASE=

# Shipping and tracking
EASYPOST_API_KEY=
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=

# Push, SMS, and outbound webhooks
FIREBASE_CREDENTIALS_PATH=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WEBHOOK_SECRET_KEY=
